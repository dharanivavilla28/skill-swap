# SkillSwap Environment Variables Template

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="skillswap_super_secret_jwt_key_change_in_production_32chars"
JWT_SECRET="skillswap_jwt_session_signing_secret_key_minimum_32_characters"

# Database Connection
# By default, SkillSwap is configured with Prisma.
# For local zero-configuration persistence without requiring an external PostgreSQL daemon,
# SQLite is configured with file:./dev.db.
# To switch to PostgreSQL (as specified for production campus deployment):
# 1. Update prisma/schema.prisma: provider = "postgresql"
# 2. Set DATABASE_URL to your PostgreSQL connection string:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillswap?schema=public"
DATABASE_URL="file:./dev.db"

# Minimum Balance & Credit Policy
STARTING_CREDIT_BALANCE="5.0"
MINIMUM_CREDIT_BALANCE="0.0"
HOURLY_CREDIT_RATE="1.0"

# Optional Campus Configuration
NEXT_PUBLIC_DEFAULT_CAMPUS="Metro State University"
